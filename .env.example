# Created by `bash setup.sh` with random values. Copy by hand only if you skip the script.
HMAC_KEY=replace-with-64-hex-chars
MAILPIT_UI_USER=qa
MAILPIT_UI_PASSWORD=replace-me
TUNNEL_TOKEN=

